# FinBridge production configuration — copy to deploy/.env.production and fill in.
#   cp deploy/.env.production.example deploy/.env.production
# Generate secrets with: openssl rand -hex 32

# --- Database (used by the postgres container AND to build DATABASE_URL) ---
POSTGRES_USER=finbridge
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
POSTGRES_DB=finbridge

# --- Ingress ---
CADDY_INGRESS_DOMAIN=hackathon.com.ly
ACME_EMAIL=YOU@EXAMPLE.COM

# --- Server ---
# Overrides the sandbox defaults — must be unique and secret in production.
ADMIN_SECRET=CHANGE_ME_admin_openssl_rand_hex_32
WEBHOOK_SECRET_SIM_PROVIDER_B=CHANGE_ME_whsec_openssl_rand_hex_32

# --- Rate limiting (documented in docs/security.md) ---
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_REQUESTS=20

# --- Webhook replay protection ---
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# --- Session (for human Console authentication) — MUST be set, or production
# silently falls back to the public dev default committed in config.ts. ---
SESSION_SECRET=CHANGE_ME_session_openssl_rand_base64_32

# --- Google OAuth (for human Console authentication) ---
# Authorized redirect URI in Google Cloud Console must be:
#   https://api.${CADDY_INGRESS_DOMAIN}/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://api.hackathon.com.ly/auth/google/callback

# --- CORS: origins allowed to call the API with credentials (dashboard origins) ---
CORS_ORIGINS=https://hackathon.com.ly,https://www.hackathon.com.ly

# --- Frontend origin the Google OAuth callback redirects back to after login ---
FRONTEND_URL=https://hackathon.com.ly