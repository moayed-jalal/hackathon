# FinBridge sandbox environment — SYNTHETIC VALUES ONLY. Never put real secrets here.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://finbridge:finbridge_sandbox@localhost:5544/finbridge

# --- Admin (used only to create sandbox merchants via POST /api/v1/merchants) ---
# Synthetic bootstrap secret — rotate freely, this is sandbox-only.
ADMIN_SECRET=admin_sandbox_secret_change_me

# --- Simulated provider webhook signing secrets (sandbox-only, not real financial secrets) ---
WEBHOOK_SECRET_SIM_PROVIDER_B=whsec_sandbox_sim_provider_b_test_key

# --- Rate limiting (documented in docs/security.md) ---
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_REQUESTS=20

# --- Webhook replay protection ---
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# --- Google OAuth (for human Console authentication) ---
# Create OAuth 2.0 credentials in Google Cloud Console:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Authorized redirect URIs: http://localhost:4000/auth/google/callback
# 4. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- Session (for human Console authentication) ---
# Generate a strong random secret: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here_generate_with_openssl_rand_base64_32

# --- CORS: origins allowed to call this API with credentials (dashboard origins) ---
CORS_ORIGINS=http://localhost:5180,https://hackathon.com.ly,https://www.hackathon.com.ly

# --- Frontend origin the Google OAuth callback redirects back to after login ---
FRONTEND_URL=http://localhost:5180

# --- Frontend (web/.env.local) ---
# Leave unset for local dev: web/vite.config.ts proxies /api and /auth to
# localhost:4000, so the dashboard calls same-origin paths (no CORS needed).
# Set this only for a production build whose API lives on a different origin.
# VITE_API_BASE_URL=https://api.hackathon.com.ly